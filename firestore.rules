rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidProcessedVideo(data) {
      return data.keys().hasAll(['videoId', 'subtitles', 'createdAt']) &&
             data.videoId is string && data.videoId.size() <= 256 &&
             data.subtitles is list && data.subtitles.size() <= 2000 &&
             data.createdAt is string;
    }

    match /processed_videos/{videoId} {
      allow read: if true;
      allow create, update: if isValidProcessedVideo(request.resource.data);
      allow delete: if true;
    }
  }
}
